APP_ENV=development
PORT=8080
DATABASE_URL=postgres://farewatch:farewatch@localhost:5432/farewatch?sslmode=disable
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
WORKER_COUNT=8
RATE_LIMIT_PER_SEC=20
CACHE_TTL_SECONDS=900
HTTP_RATE_LIMIT_PER_SEC=5
HTTP_RATE_LIMIT_BURST=15
FARE_RETENTION_DAYS=90
VITE_API_URL=http://localhost:8080/graphql
JWT_SECRET=farewatch-dev-secret-change-me

# Fare sources (optional)
IGNAV_API_KEY=
TRAVELPAYOUTS_TOKEN=
RAPIDAPI_KEY=

# Firebase Google sign-in (optional)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SMTP alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
