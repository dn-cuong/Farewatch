# development | production — gates GraphiQL, permissive localhost CORS, and
# whether the app refuses to boot with the default JWT_SECRET.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://farewatch:farewatch@localhost:5432/farewatch?sslmode=disable
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
WORKER_COUNT=8
RATE_LIMIT_PER_SEC=20
CACHE_TTL_SECONDS=900
# Per-IP throttle on the public /graphql endpoint (sustained req/s, burst size).
HTTP_RATE_LIMIT_PER_SEC=5
HTTP_RATE_LIMIT_BURST=15
# How long fare history rows are kept before the scanner prunes them.
FARE_RETENTION_DAYS=90
VITE_API_URL=http://localhost:8080/graphql
# In production this MUST be overridden with a strong random secret — the API
# refuses to start with this default when APP_ENV=production.
JWT_SECRET=farewatch-dev-secret-change-me

# Live fares via Ignav (https://ignav.com — free tier available)
IGNAV_API_KEY=

# Additional free-tier fare sources (both require free account keys)
# https://www.travelpayouts.com/developers/api
TRAVELPAYOUTS_TOKEN=
# RapidAPI "Sky Scrapper" Basic plan
RAPIDAPI_KEY=

# Optional Firebase Auth (Google). Leave blank to use email/password only.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SMTP for fare-drop alerts (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
